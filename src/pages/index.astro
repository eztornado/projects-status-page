---
const services = [
  { name: "API Reigreen", url: "https://api.reigreengroup.com" },
  { name: "Clientes Reigreen", url: "https://clientes.reigreengroup.com" },
  { name: "OCR Reigreen", url: "https://ocr.reigreengroup.com" },
  { name: "Magika Reigreen", url: "https://magika.reigreengroup.com" },
  { name: "n8n Reigreen", url: "https://n8n.reigreengroup.com" }
];
---
<Layout title="Estado del Sistema">
  <div class="max-w-4xl mx-auto py-12 px-4">
    <header class="mb-12 text-center">
      <h1 class="text-4xl font-bold mb-4">Estado del Sistema</h1>
      <p class="text-slate-600">Monitoreamos la disponibilidad de nuestros servicios para asegurar la mejor experiencia.</p>
    </header>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => (
        <div class="p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-semibold text-lg">{service.name}</h2>
            <span id="status-{index}" class="px-2 py-1 rounded text-xs font-medium bg-slate-100 text-slate-700">
              Cargando...
            </span>
          </div>
          <p class="text-sm text-slate-500 mb-4">{service.url}</p>
          <div class="flex items-center text-sm text-slate-400">
            <span class="mr-2">Uptime:</span>
            <span id="uptime-{index}" class="font-mono">--</span>
          </div>
        </div>
      ))}
    </div>

    <footer class="mt-16 pt-8 border-t border-slate-200 text-center text-slate-500 text-sm">
      &copy; 2026 Reigreen Group. Actualizado automáticamente.
    </footer>
  </div>

  <script define:vars={{ services }}>
    async function checkStatus() {
      const results = await Promise.all(services.map(async (service, index) => {
        try {
          const start = performance.now();
          const response = await fetch(service.url, { mode: 'no-cors', cache: 'no-store' });
          const end = performance.now();
          const latency = Math.round(end - start);

          const statusEl = document.getElementById(`status-${index}`);
          const uptimeEl = document.getElementById(`uptime-${index}`);

          if (statusEl && uptimeEl) {
            statusEl.textContent = 'Online';
            statusEl.className = 'px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-700';
            uptimeEl.textContent = `${latency}ms`;
          }

          return { ...service, status: 'up', uptime: `${latency}ms` };
        } catch (error) {
          const statusEl = document.getElementById(`status-${index}`);
          const uptimeEl = document.getElementById(`uptime-${index}`);

          if (statusEl && uptimeEl) {
            statusEl.textContent = 'Offline';
            statusEl.className = 'px-2 py-1 rounded text-xs font-medium bg-red-100 text-red-700';
            uptimeEl.textContent = 'Offline';
          }

          return { ...service, status: 'down', uptime = 'Offline' };
        }
      }));
    }

    setInterval(checkStatus, 30000);
    checkStatus();
  </script>
</Layout>

