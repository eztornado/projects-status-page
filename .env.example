# Nombre del proyecto mostrado en la página (versión pública: cámbialo y listo)
APP_NAME=Reigreengroup

# ============================================
# SERVICIOS (versión pública / marca blanca)
# ============================================
# Si defines alguna variable SVC_*, la lista de servicios a monitorizar viene
# de ellas y se ignora el fichero. Formato: SVC_<ID>_<CAMPO>
#
#   SVC_WEB_NAME=Web
#   SVC_WEB_URL=https://web.cliente.com
#   SVC_API_NAME=API
#   SVC_API_URL=https://api.cliente.com
#   SVC_API_DOCS_URL=https://api.cliente.com/docs
#   SVC_API_DESCRIPTION=API pública del cliente
#   SVC_BD_TYPE=mysql
#   SVC_BD_HOST=db.interno
#   SVC_BD_PORT=3306
#
# Campos HTTP: NAME, URL, DOCS_URL, DESCRIPTION, VERIFY_TLS (defecto true)
# Campos MySQL: TYPE=mysql, HOST, PORT (defecto 3306)
# Sin SVC_* se usa backend/services.yaml del repositorio.

# Alternativa: ruta a un fichero YAML montado por volumen
# (por defecto se usa backend/services.yaml del repositorio)
SERVICES_FILE=

# Puerto expuesto por el contenedor
PORT=8000

# Credenciales MySQL para el check de la BD en tornadocore.netbird.vpn
# (si se dejan vacías, el check se limita a la conexión TCP)
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Intervalo de comprobación en minutos (por defecto 5)
CHECK_INTERVAL_MINUTES=5

# Días de retención del histórico (por defecto 7)
RETENTION_DAYS=7

# ============================================
# CONFIGURACIÓN DE TELEGRAM
# ============================================
# Habilitar notificaciones por Telegram (TRUE/FALSE)
TELEGRAM_ENABLED=false

# Token del bot de Telegram (obtenido en @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID donde recibir las notificaciones (puedes usar tu grupo de Telegram o usar @userinfobot para obtener tu ID)
TELEGRAM_CHAT_ID=

# ============================================
# COOLIFY WEBHOOK (OPCIONAL)
# ============================================
# URL del webhook de Coolify para recibir notificaciones (opcional)
COOLIFY_WEBHOOK_URL=
